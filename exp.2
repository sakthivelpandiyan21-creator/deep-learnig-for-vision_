        "import numpy as np\n",
        "\n",
        "def sigmoid(x):\n",
        "  return 1 / (1 + np.exp(-x))\n",
        "\n",
        "def sigmoid_derivative(x):\n",
        "  return x * (1 - x)\n",
        "\n",
        "# XOR input and expected output\n",
        "X = np.array([[0,0], [0,1], [1,0], [1,1]])\n",
        "Y = np.array([[0], [1], [1], [0]])\n",
        "\n",
        "np.random.seed(1)\n",
        "\n",
        "# Layer dimensions\n",
        "input_dim = 2\n",
        "hidden_dim = 4\n",
        "output_dim = 1\n",
        "\n",
        "# Weight initialization\n",
        "weights_0_1 = 2 * np.random.random((input_dim, hidden_dim)) - 1\n",
        "weights_1_2 = 2 * np.random.random((hidden_dim, output_dim)) - 1\n",
        "\n",
        "learning_rate = 0.5\n",
        "\n",
        "for epoch in range(20000):\n",
        "  # Forward pass\n",
        "  layer_0 = X\n",
        "  layer_1 = sigmoid(np.dot(layer_0, weights_0_1))\n",
        "  layer_2 = sigmoid(np.dot(layer_1, weights_1_2))\n",
        "\n",
        "  # Backpropagation\n",
        "  layer_2_error = Y - layer_2\n",
        "  layer_2_delta = layer_2_error * sigmoid_derivative(layer_2)\n",
        "\n",
        "  layer_1_error = layer_2_delta.dot(weights_1_2.T)\n",
        "  layer_1_delta = layer_1_error * sigmoid_derivative(layer_1)\n",
        "\n",
        "  # Gradient descent update\n",
        "  weights_1_2 += layer_1.T.dot(layer_2_delta) * learning_rate\n",
        "  weights_0_1 += layer_0.T.dot(layer_1_delta) * learning_rate\n",
        "\n",
        "print(\"Predicted Output after training (XOR):\")\n",
        "print(layer_2)"
      ]
    }
  ]
